import React, { useState, useEffect, Fragment } from "react";
import { useQuery, useMutation } from "@tanstack/react-query";
import { useToast } from "@/hooks/use-toast";
import { useAuth } from "@/hooks/use-auth";
import { Skill, insertSkillSchema, PendingSkillUpdate, SkillTemplate, SkillCategory, SkillSubcategory } from "@shared/schema";
import { apiRequest, queryClient } from "@/lib/queryClient";
import { z } from "zod";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from "@/components/ui/dialog";
import {
  Table,
  TableBody,
  TableCaption,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import { Button } from "@/components/ui/button";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Label } from "@/components/ui/label";
import { Checkbox } from "@/components/ui/checkbox";
import {
  Accordion,
  AccordionContent,
  AccordionItem,
  AccordionTrigger,
} from "@/components/ui/accordion";
import { Loader2, PlusCircle, AlertCircle, Check, X } from "lucide-react";
import { Alert, AlertTitle, AlertDescription } from "@/components/ui/alert";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { format } from "date-fns";
import { Calendar } from "@/components/ui/calendar";
import {
  Popover,
  PopoverContent,
  PopoverTrigger,
} from "@/components/ui/popover";
import { cn } from "@/lib/utils";
import { Card, CardHeader, CardContent, CardTitle, CardDescription } from "@/components/ui/card";
import { Switch } from "@/components/ui/switch";

// Define schema for certification data
const certificationSchema = z.object({
  name: z.string().min(1, "Certification name is required"),
  link: z.string().optional(),
  id: z.string()
});

// Define the skill submission schema
const skillSubmitSchema = z.object({
  name: z.string().min(1, "Skill name is required"),
  userId: z.number(),
  category: z.string().min(1, "Category is required"),
  level: z.enum(["beginner", "intermediate", "expert"]),
  notes: z.string().optional(),
  changeNote: z.string().optional(),
  certifications: z.array(certificationSchema),
  selected: z.boolean(),
  categoryId: z.number().nullable().optional(),
  subcategoryId: z.number().nullable().optional(),
  certificationDate: z.date().optional(),
  expirationDate: z.date().optional()
});

type Certification = z.infer<typeof certificationSchema>;
type SkillEntry = z.infer<typeof skillSubmitSchema>;

export default function AddSkillsPage() {
  const { toast } = useToast();
  const auth = useAuth();
  const userId = auth.user?.id || 0;
  
  const [selectedCategory, setSelectedCategory] = useState<string | null>(null);
  const [selectedSkills, setSelectedSkills] = useState<Record<string, boolean>>({});
  const [skillsList, setSkillsList] = useState<SkillEntry[]>([]);
  const [showAddDialog, setShowAddDialog] = useState(false);
  const [addingSkill, setAddingSkill] = useState(false);
  const [submittingSkills, setSubmittingSkills] = useState(false);
  const [pendingSubmissions, setPendingSubmissions] = useState(0);
  const [showApprovalInfo, setShowApprovalInfo] = useState(false);
  const [certDate, setCertDate] = useState<Date | undefined>(undefined);
  const [expDate, setExpDate] = useState<Date | undefined>(undefined);
  const [selectedCategoryId, setSelectedCategoryId] = useState<number | null>(null);
  const [selectedSubcategoryId, setSelectedSubcategoryId] = useState<number | null>(null);
  const [certifications, setCertifications] = useState<Certification[]>([
    { name: "", link: "", id: "cert-" + Math.random().toString(36).substring(2, 9) }
  ]);
  const [skillLevel, setSkillLevel] = useState<"beginner" | "intermediate" | "expert">("beginner");
  const [skillName, setSkillName] = useState("");
  const [skillDescription, setSkillDescription] = useState("");
  const [changeNote, setChangeNote] = useState("");
  const [categoryTab, setCategoryTab] = useState<string>("technical");
  const [isAdmin, setIsAdmin] = useState(false);

  // Fetch categories
  const { data: categories, isLoading: loadingCategories } = useQuery({
    queryKey: ["/api/skill-categories"],
  });

  // Fetch subcategories
  const { data: subcategories, isLoading: loadingSubcategories } = useQuery({
    queryKey: ["/api/skill-subcategories"],
  });

  // Fetch user skills
  const { data: userSkills, isLoading: loadingUserSkills } = useQuery({
    queryKey: ["/api/user-skills", userId],
    enabled: userId > 0,
  });

  // Fetch any pending skill updates
  const { data: pendingUpdates, isLoading: loadingPendingUpdates } = useQuery({
    queryKey: ["/api/pending-skill-updates", userId],
    enabled: userId > 0,
  });

  // Fetch skill templates
  const { data: skillTemplates, isLoading: loadingTemplates } = useQuery({
    queryKey: ["/api/skill-templates"],
  });

  // Check if user is admin
  useEffect(() => {
    if (auth.user) {
      setIsAdmin(auth.user.is_admin || false);
    }
  }, [auth.user]);

  // Filter categories based on tab selection
  const filteredCategories = React.useMemo(() => {
    if (!categories) return [];
    
    // Special handling for categories known to be technical
    const isTechnicalCategory = (cat: SkillCategory) => {
      // Normalize category name for comparison
      const name = cat.name.trim().toLowerCase();
      
      // Special case for "BigData" and "Messaging & Streaming" which should always be technical
      if (name === "bigdata" || name === "big data" || 
          name === "messaging & streaming" || name === "messaging and streaming") {
        return true;
      }
      
      // Otherwise use the category_type field from database
      // Normalize the category_type value to handle case and whitespace differences
      const categoryType = (cat.category_type || "").trim().toLowerCase();
      return categoryType === "technical";
    };
    
    return categories.filter(cat => {
      if (categoryTab === "technical") {
        return isTechnicalCategory(cat);
      } else {
        // For functional tab, special cases are excluded
        const name = cat.name.trim().toLowerCase();
        if (name === "bigdata" || name === "big data" || 
            name === "messaging & streaming" || name === "messaging and streaming") {
          return false;
        }
        
        const categoryType = (cat.category_type || "").trim().toLowerCase();
        return categoryType !== "technical";
      }
    });
  }, [categories, categoryTab]);

  // Prepare user skills data
  useEffect(() => {
    if (userSkills && userSkills.length > 0) {
      const skills = userSkills.map(skill => ({
        name: skill.name,
        userId: userId,
        category: skill.category,
        categoryId: skill.category_id,
        subcategoryId: skill.subcategory_id,
        level: skill.level || "beginner",
        certification: skill.certification || "",
        credlyLink: skill.credly_link || "",
        notes: skill.notes || "",
        changeNote: "",
        selected: false,
        certificationDate: skill.certification_date ? new Date(skill.certification_date) : undefined,
        expirationDate: skill.expiration_date ? new Date(skill.expiration_date) : undefined,
        certifications: skill.certifications || []
      }));
      setSkillsList(skills);
    }
  }, [userSkills, userId]);

  // Check for pending updates
  useEffect(() => {
    if (pendingUpdates && pendingUpdates.length > 0) {
      const pendingCount = pendingUpdates.filter(update => 
        update.status === "pending" || update.status === "in_review"
      ).length;
      
      setPendingSubmissions(pendingCount);
      if (pendingCount > 0) {
        setShowApprovalInfo(true);
      }
    }
  }, [pendingUpdates]);

  const addCertification = () => {
    setCertifications([
      ...certifications,
      { name: "", link: "", id: "cert-" + Math.random().toString(36).substring(2, 9) }
    ]);
  };

  const removeCertification = (id: string) => {
    if (certifications.length <= 1) {
      // Always keep at least one certification form
      setCertifications([{ name: "", link: "", id: "cert-" + Math.random().toString(36).substring(2, 9) }]);
    } else {
      setCertifications(certifications.filter(cert => cert.id !== id));
    }
  };

  const updateCertification = (id: string, field: 'name' | 'link', value: string) => {
    setCertifications(certifications.map(cert => 
      cert.id === id ? { ...cert, [field]: value } : cert
    ));
  };

  const resetCertifications = () => {
    setCertifications([{ name: "", link: "", id: "cert-" + Math.random().toString(36).substring(2, 9) }]);
  };

  // Add new skill mutation
  const addSkillMutation = useMutation({
    mutationFn: async (skillData: SkillEntry) => {
      return await apiRequest("POST", "/api/pending-skill-updates", skillData);
    },
    onSuccess: () => {
      toast({
        title: "Skill submission successful",
        description: "Your skill has been submitted for approval.",
      });
      
      // Reset form
      setSkillName("");
      setSkillDescription("");
      setSkillLevel("beginner");
      setSelectedCategoryId(null);
      setSelectedSubcategoryId(null);
      setCertDate(undefined);
      setExpDate(undefined);
      resetCertifications();
      setChangeNote("");
      
      // Close dialog
      setShowAddDialog(false);
      setAddingSkill(false);
      
      // Refresh pending updates
      queryClient.invalidateQueries({ queryKey: ["/api/pending-skill-updates", userId] });
    },
    onError: (error) => {
      toast({
        title: "Error submitting skill",
        description: `${error}`,
        variant: "destructive",
      });
      setAddingSkill(false);
    }
  });

  // Submit skill update mutation
  const submitSkillUpdateMutation = useMutation({
    mutationFn: async (skillUpdates: PendingSkillUpdate[]) => {
      return await apiRequest("POST", "/api/pending-skill-updates/batch", { updates: skillUpdates });
    },
    onSuccess: () => {
      toast({
        title: "Skill updates submitted",
        description: "Your skill updates have been submitted for approval.",
      });
      
      // Reset selected skills
      setSelectedSkills({});
      
      // Reset skill change notes
      setSkillsList(prevList => 
        prevList.map(skill => ({ ...skill, changeNote: "", selected: false }))
      );
      
      setSubmittingSkills(false);
      
      // Refresh pending updates
      queryClient.invalidateQueries({ queryKey: ["/api/pending-skill-updates", userId] });
    },
    onError: (error) => {
      toast({
        title: "Error submitting updates",
        description: `${error}`,
        variant: "destructive",
      });
      setSubmittingSkills(false);
    }
  });

  // Handle skill selection toggle
  const handleSkillSelect = (skillName: string) => {
    setSelectedSkills(prev => ({
      ...prev,
      [skillName]: !prev[skillName]
    }));
  };

  // Handle skill level change
  const handleSkillLevelChange = (skillName: string, level: string) => {
    setSkillsList(prevList => 
      prevList.map(skill => 
        skill.name === skillName 
          ? { ...skill, level: level as "beginner" | "intermediate" | "expert" } 
          : skill
      )
    );
  };

  // Handle description change
  const handleDescriptionChange = (skillName: string, description: string) => {
    setSkillsList(prevList => 
      prevList.map(skill => 
        skill.name === skillName 
          ? { ...skill, notes: description } 
          : skill
      )
    );
  };

  // Handle certification change
  const handleCertificationChange = (skillName: string, certification: string) => {
    setSkillsList(prevList => 
      prevList.map(skill => 
        skill.name === skillName 
          ? { ...skill, certification } 
          : skill
      )
    );
  };

  // Handle certification link change
  const handleCertificationLinkChange = (skillName: string, credlyLink: string) => {
    setSkillsList(prevList => 
      prevList.map(skill => 
        skill.name === skillName 
          ? { ...skill, credlyLink } 
          : skill
      )
    );
  };

  // Handle change note update
  const handleChangeNoteUpdate = (skillName: string, note: string) => {
    setSkillsList(prevList => 
      prevList.map(skill => 
        skill.name === skillName 
          ? { ...skill, changeNote: note } 
          : skill
      )
    );
  };

  // Submit new skill
  const handleAddSkill = async () => {
    if (!skillName || !selectedCategoryId) {
      toast({
        title: "Missing information",
        description: "Please fill out all required fields.",
        variant: "destructive",
      });
      return;
    }
    
    setAddingSkill(true);
    
    // Filter empty certifications
    const validCertifications = certifications.filter(cert => cert.name.trim() !== "");
    
    try {
      const newSkill: SkillEntry = {
        name: skillName,
        userId: userId,
        category: categories?.find(c => c.id === selectedCategoryId)?.name || "",
        categoryId: selectedCategoryId,
        subcategoryId: selectedSubcategoryId,
        level: skillLevel,
        certifications: validCertifications,
        notes: skillDescription,
        changeNote: changeNote || "Initial skill submission",
        selected: true,
        certificationDate: certDate,
        expirationDate: expDate
      };
      
      await addSkillMutation.mutateAsync(newSkill);
    } catch (error) {
      // Error handled by mutation
      console.error("Error adding skill:", error);
    }
  };

  // Submit skill updates
  const handleSubmitUpdates = async () => {
    const selectedSkillsArray = skillsList.filter(skill => selectedSkills[skill.name]);
    
    if (selectedSkillsArray.length === 0) {
      toast({
        title: "No skills selected",
        description: "Please select at least one skill to update.",
        variant: "destructive",
      });
      return;
    }
    
    const missingNotes = selectedSkillsArray.filter(skill => !skill.changeNote);
    if (missingNotes.length > 0) {
      toast({
        title: "Missing information",
        description: "Please provide change notes for all selected skills.",
        variant: "destructive",
      });
      return;
    }
    
    setSubmittingSkills(true);
    
    try {
      const updates: PendingSkillUpdate[] = selectedSkillsArray.map(skill => ({
        userId: userId,
        skillName: skill.name,
        categoryId: skill.categoryId,
        subcategoryId: skill.subcategoryId,
        level: skill.level,
        notes: skill.notes,
        changeNote: skill.changeNote,
        certifications: skill.certifications || [],
        status: "pending"
      }));
      
      await submitSkillUpdateMutation.mutateAsync(updates);
    } catch (error) {
      // Error handled by mutation
      console.error("Error submitting updates:", error);
    }
  };

  // Loading state
  if (loadingCategories || loadingSubcategories || loadingUserSkills || loadingPendingUpdates || loadingTemplates) {
    return (
      <div className="flex items-center justify-center h-screen">
        <Loader2 className="h-8 w-8 animate-spin" />
        <span className="ml-2">Loading skills data...</span>
      </div>
    );
  }

  return (
    <div className="container mx-auto py-6">
      <h1 className="text-2xl font-bold mb-6">Manage Your Skills</h1>
      
      {/* Pending approval info */}
      {showApprovalInfo && pendingSubmissions > 0 && (
        <Alert className="mb-6">
          <AlertCircle className="h-4 w-4" />
          <AlertTitle>Pending Approval</AlertTitle>
          <AlertDescription>
            You have {pendingSubmissions} skill {pendingSubmissions === 1 ? 'update' : 'updates'} pending approval. 
            New submissions will be added to this queue.
          </AlertDescription>
        </Alert>
      )}
      
      <div className="flex justify-between mb-6">
        <Button onClick={() => setShowAddDialog(true)}>
          <PlusCircle className="h-4 w-4 mr-2" />
          Add New Skill
        </Button>
        
        <Button variant="outline" onClick={handleSubmitUpdates} disabled={submittingSkills}>
          {submittingSkills ? (
            <>
              <Loader2 className="h-4 w-4 mr-2 animate-spin" />
              Submitting...
            </>
          ) : "Submit Selected Changes"}
        </Button>
      </div>
      
      {/* Skills tabs */}
      <Tabs 
        defaultValue="technical" 
        onValueChange={setCategoryTab} 
        className="mt-6"
      >
        <TabsList className="mb-4">
          <TabsTrigger value="technical">Technical Skills</TabsTrigger>
          <TabsTrigger value="functional">Functional Skills</TabsTrigger>
        </TabsList>
        
        {/* Category tabs */}
        <div className="border rounded-lg p-4">
          <Tabs defaultValue={filteredCategories[0]?.id.toString() || "0"}>
            <TabsList className="mb-4 flex flex-wrap h-auto">
              {filteredCategories.map(category => (
                <TabsTrigger 
                  key={category.id} 
                  value={category.id.toString()}
                  onClick={() => setSelectedCategory(category.name)}
                >
                  {category.name}
                </TabsTrigger>
              ))}
            </TabsList>
            
            {filteredCategories.map(category => (
              <TabsContent key={category.id} value={category.id.toString()}>
                <div className="overflow-x-auto">
                  <Table>
                    <TableHeader>
                      <TableRow>
                        <TableHead className="w-[50px]">Select</TableHead>
                        <TableHead>Skill</TableHead>
                        <TableHead>Level</TableHead>
                        <TableHead>Description/Notes</TableHead>
                        <TableHead>Certification</TableHead>
                      </TableRow>
                    </TableHeader>
                    <TableBody>
                      {subcategories && subcategories.length > 0 && subcategories
                        .filter(sub => sub.category_id === category.id)
                        .map(subcategory => {
                          // Get skills that match this subcategory
                          const subcategorySkillTemplates = skillTemplates?.filter(
                            template => template.subcategory_id === subcategory.id
                          ) || [];
                          
                          // Skip subcategories with no templates
                          if (subcategorySkillTemplates.length === 0) {
                            return null;
                          }
                          
                          return (
                            <Fragment key={subcategory.id}>
                              {/* Subcategory header */}
                              <TableRow className="bg-muted/50">
                                <TableCell colSpan={5} className="py-2">
                                  <div className="flex items-center gap-2 font-medium">
                                    {subcategory.name}
                                  </div>
                                </TableCell>
                              </TableRow>
                              
                              {/* Skill templates for this subcategory */}
                              {subcategorySkillTemplates.map(template => {
                                // Check if user already has this skill
                                const existingSkill = skillsList.find(
                                  skill => skill.name === template.name
                                );
                                
                                // Skip if it's a direct match (user already has this skill)
                                if (existingSkill) {
                                  return (
                                    <TableRow key={template.id}>
                                      <TableCell>
                                        <Checkbox
                                          checked={selectedSkills[existingSkill.name] || false}
                                          onCheckedChange={() => handleSkillSelect(existingSkill.name)}
                                          id={`select-${template.id}`}
                                        />
                                      </TableCell>
                                      <TableCell>
                                        <div className="font-medium">{template.name}</div>
                                        {selectedSkills[existingSkill.name] && (
                                          <Textarea
                                            placeholder="Enter reason for change"
                                            value={existingSkill.changeNote || ""}
                                            onChange={(e) => handleChangeNoteUpdate(existingSkill.name, e.target.value)}
                                            className="mt-2 text-xs h-16"
                                          />
                                        )}
                                      </TableCell>
                                      <TableCell>
                                        <Select
                                          value={existingSkill.level}
                                          onValueChange={(value) => handleSkillLevelChange(existingSkill.name, value)}
                                          disabled={!selectedSkills[existingSkill.name]}
                                        >
                                          <SelectTrigger className="w-[140px]">
                                            <SelectValue placeholder="Select level" />
                                          </SelectTrigger>
                                          <SelectContent>
                                            <SelectItem value="beginner">Beginner</SelectItem>
                                            <SelectItem value="intermediate">Intermediate</SelectItem>
                                            <SelectItem value="expert">Expert</SelectItem>
                                          </SelectContent>
                                        </Select>
                                      </TableCell>
                                      <TableCell>
                                        <Textarea
                                          placeholder="Add notes or description"
                                          value={existingSkill.notes || ""}
                                          onChange={(e) => handleDescriptionChange(existingSkill.name, e.target.value)}
                                          disabled={!selectedSkills[existingSkill.name]}
                                          className="w-full max-w-xs h-16 text-xs"
                                        />
                                      </TableCell>
                                      <TableCell>
                                        <div className="space-y-1">
                                          <Input
                                            placeholder="Certification name"
                                            value={existingSkill.certification || ""}
                                            onChange={(e) => handleCertificationChange(existingSkill.name, e.target.value)}
                                            disabled={!selectedSkills[existingSkill.name]}
                                            className="w-full max-w-xs text-xs"
                                          />
                                          <Input
                                            placeholder="Certification link"
                                            value={existingSkill.credlyLink || ""}
                                            onChange={(e) => handleCertificationLinkChange(existingSkill.name, e.target.value)}
                                            disabled={!selectedSkills[existingSkill.name]}
                                            className="w-full max-w-xs text-xs mt-1"
                                          />
                                        </div>
                                      </TableCell>
                                    </TableRow>
                                  );
                                }
                                
                                // Otherwise return a row for a skill the user doesn't have yet
                                return (
                                  <TableRow key={template.id} className="text-muted-foreground">
                                    <TableCell>
                                      <Button 
                                        variant="ghost" 
                                        size="sm"
                                        onClick={() => {
                                          setShowAddDialog(true);
                                          setSkillName(template.name);
                                          setSelectedCategoryId(category.id);
                                          setSelectedSubcategoryId(subcategory.id);
                                        }}
                                      >
                                        <PlusCircle className="h-4 w-4" />
                                      </Button>
                                    </TableCell>
                                    <TableCell>{template.name}</TableCell>
                                    <TableCell colSpan={3}>
                                      <em>Click + to add this skill to your profile</em>
                                    </TableCell>
                                  </TableRow>
                                );
                              })}
                            </Fragment>
                          );
                        })}
                    </TableBody>
                  </Table>
                </div>
              </TabsContent>
            ))}
          </Tabs>
        </div>
      </Tabs>
      
      {/* Add skill dialog */}
      <Dialog open={showAddDialog} onOpenChange={setShowAddDialog}>
        <DialogContent className="max-w-2xl max-h-[90vh] overflow-y-auto">
          <DialogHeader>
            <DialogTitle>Add New Skill</DialogTitle>
            <DialogDescription>
              Add a new skill to your profile. This will be sent for approval.
            </DialogDescription>
          </DialogHeader>
          
          <div className="grid gap-4 py-4">
            <div className="grid grid-cols-4 items-center gap-4">
              <Label htmlFor="skill-name" className="text-right">
                Skill Name
              </Label>
              <Input
                id="skill-name"
                value={skillName}
                onChange={(e) => setSkillName(e.target.value)}
                className="col-span-3"
                placeholder="Enter skill name"
              />
            </div>
            
            <div className="grid grid-cols-4 items-center gap-4">
              <Label htmlFor="category" className="text-right">
                Category
              </Label>
              <Select 
                value={selectedCategoryId?.toString() || ""} 
                onValueChange={(value) => setSelectedCategoryId(parseInt(value))}
              >
                <SelectTrigger className="col-span-3">
                  <SelectValue placeholder="Select category" />
                </SelectTrigger>
                <SelectContent>
                  {categories && categories.map(category => (
                    <SelectItem key={category.id} value={category.id.toString()}>
                      {category.name}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>
            
            <div className="grid grid-cols-4 items-center gap-4">
              <Label htmlFor="subcategory" className="text-right">
                Subcategory
              </Label>
              <Select 
                value={selectedSubcategoryId?.toString() || ""} 
                onValueChange={(value) => setSelectedSubcategoryId(parseInt(value))}
                disabled={!selectedCategoryId}
              >
                <SelectTrigger className="col-span-3">
                  <SelectValue placeholder="Select subcategory" />
                </SelectTrigger>
                <SelectContent>
                  {subcategories && selectedCategoryId &&
                    subcategories
                      .filter(sub => sub.category_id === selectedCategoryId)
                      .map(subcategory => (
                        <SelectItem key={subcategory.id} value={subcategory.id.toString()}>
                          {subcategory.name}
                        </SelectItem>
                      ))
                  }
                </SelectContent>
              </Select>
            </div>
            
            <div className="grid grid-cols-4 items-center gap-4">
              <Label htmlFor="skill-level" className="text-right">
                Skill Level
              </Label>
              <Select value={skillLevel} onValueChange={(value: any) => setSkillLevel(value)}>
                <SelectTrigger className="col-span-3">
                  <SelectValue placeholder="Select level" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="beginner">Beginner</SelectItem>
                  <SelectItem value="intermediate">Intermediate</SelectItem>
                  <SelectItem value="expert">Expert</SelectItem>
                </SelectContent>
              </Select>
            </div>
            
            <div className="grid grid-cols-4 items-start gap-4">
              <Label htmlFor="skill-description" className="text-right pt-2">
                Description
              </Label>
              <Textarea
                id="skill-description"
                value={skillDescription}
                onChange={(e) => setSkillDescription(e.target.value)}
                className="col-span-3"
                placeholder="Add notes or description"
              />
            </div>
            
            <div className="grid grid-cols-4 items-start gap-4">
              <Label className="text-right pt-2">
                Certifications
              </Label>
              <div className="col-span-3 space-y-3">
                {certifications.map((cert, index) => (
                  <div key={cert.id} className="flex items-center gap-2">
                    <Input
                      placeholder="Certification name"
                      value={cert.name}
                      onChange={(e) => updateCertification(cert.id, 'name', e.target.value)}
                      className="flex-1"
                    />
                    <Input
                      placeholder="Link to credential (optional)"
                      value={cert.link || ""}
                      onChange={(e) => updateCertification(cert.id, 'link', e.target.value)}
                      className="flex-1"
                    />
                    <Button 
                      type="button" 
                      variant="ghost" 
                      size="icon"
                      onClick={() => removeCertification(cert.id)}
                    >
                      <X className="h-4 w-4" />
                    </Button>
                  </div>
                ))}
                <Button 
                  type="button" 
                  variant="outline" 
                  onClick={addCertification}
                  size="sm"
                >
                  <PlusCircle className="h-4 w-4 mr-2" />
                  Add Another Certification
                </Button>
              </div>
            </div>
            
            <div className="grid grid-cols-4 items-center gap-4">
              <Label htmlFor="cert-date" className="text-right">
                Certification Date
              </Label>
              <Popover>
                <PopoverTrigger asChild>
                  <Button
                    id="cert-date"
                    variant={"outline"}
                    className={"col-span-3 justify-start text-left font-normal" + (!certDate ? " text-muted-foreground" : "")}
                  >
                    {certDate ? format(certDate, "PPP") : "Pick a date"}
                  </Button>
                </PopoverTrigger>
                <PopoverContent className="w-auto p-0">
                  <Calendar
                    mode="single"
                    selected={certDate}
                    onSelect={setCertDate}
                    initialFocus
                  />
                </PopoverContent>
              </Popover>
            </div>
            
            <div className="grid grid-cols-4 items-center gap-4">
              <Label htmlFor="exp-date" className="text-right">
                Expiration Date
              </Label>
              <Popover>
                <PopoverTrigger asChild>
                  <Button
                    id="exp-date"
                    variant={"outline"}
                    className={"col-span-3 justify-start text-left font-normal" + (!expDate ? " text-muted-foreground" : "")}
                  >
                    {expDate ? format(expDate, "PPP") : "Pick a date"}
                  </Button>
                </PopoverTrigger>
                <PopoverContent className="w-auto p-0">
                  <Calendar
                    mode="single"
                    selected={expDate}
                    onSelect={setExpDate}
                    initialFocus
                    disabled={(date) => date < new Date()}
                  />
                </PopoverContent>
              </Popover>
            </div>
            
            <div className="grid grid-cols-4 items-start gap-4">
              <Label htmlFor="change-note" className="text-right pt-2">
                Change Note
              </Label>
              <Textarea
                id="change-note"
                value={changeNote}
                onChange={(e) => setChangeNote(e.target.value)}
                className="col-span-3"
                placeholder="Reason for adding this skill"
              />
            </div>
          </div>
          
          <DialogFooter>
            <Button type="button" variant="outline" onClick={() => setShowAddDialog(false)}>
              Cancel
            </Button>
            <Button type="button" onClick={handleAddSkill} disabled={addingSkill}>
              {addingSkill ? (
                <>
                  <Loader2 className="h-4 w-4 mr-2 animate-spin" />
                  Submitting...
                </>
              ) : "Add Skill"}
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  );
}